{
  "name": "thanksgiving-bags",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:shared && ng test --watch=false",
    "test:shared": "vitest run",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "build:pages": "ng build --base-href / && cp dist/thanksgiving-bags/browser/index.html dist/thanksgiving-bags/browser/404.html",
    "start:mock": "ng serve",
    "gen:seed": "tsx scripts/gen-seed.ts",
    "import:catalog": "tsx scripts/import-catalog.ts"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
